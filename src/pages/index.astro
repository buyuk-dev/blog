---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Meteors } from '../components/Meteors';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Meteors number={15} client:load />
		<Header />
		<main>
			<section class="intro">
				<h1>Hi, I'm Michał</h1>
				<p>
					I'm a CTO & Lead AI Software Engineer based in Poznań, Poland. Currently leading
					<a href="https://www.intelliroom.ai/">IntelliRoom</a> - an AI Due Diligence platform.
					Previously co-founded Fractile (acquired by T12).
				</p>
				<p>
					I write about software engineering, AI agents, LLMs, and other topics I find interesting.
				</p>
			</section>

			<section class="posts">
				<h2>Recent Posts</h2>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
			}
			.intro {
				margin-bottom: 2em;
			}
			.intro h1 {
				margin-bottom: 0.5em;
			}
			.intro p {
				color: rgb(var(--gray-dark));
				line-height: 1.6;
			}
			.posts h2 {
				margin-bottom: 1em;
			}
			.posts ul {
				list-style: none;
				padding: 0;
			}
			.posts li {
				margin-bottom: 1em;
			}
			.posts a {
				display: block;
				padding: 1em;
				border-radius: 8px;
				text-decoration: none;
				color: inherit;
				transition: background-color 0.2s;
			}
			.posts a:hover {
				background-color: var(--bg-secondary);
			}
			.posts .title {
				margin: 0 0 0.25em 0;
				color: rgb(var(--black));
			}
			.posts .date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
		</style>
	</body>
</html>
