---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;
const title = frontmatter?.title || 'Resume';
---

<html lang="en">
	<head>
		<BaseHead title={title} description="Michał Michalski - CTO & Lead AI Software Engineer" />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.prose h1 {
				margin-bottom: 0.25em;
			}
			.prose h2 {
				margin-top: 0;
				margin-bottom: 1em;
				color: rgb(var(--gray));
				font-weight: 400;
			}
			.prose h3 {
				margin-bottom: 0.25em;
			}
			.prose hr {
				margin: 1.5em 0;
			}
			.prose code {
				background-color: rgb(var(--gray-light));
				padding: 0.2em 0.4em;
				border-radius: 4px;
				font-size: 0.9em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="prose">
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
